* text=auto

*.fig binary
*.mat binary
*.mdl binary diff merge=mlAutoMerge
*.mdlp binary
*.mex* binary
*.mlapp binary
*.mldatx binary merge=mlAutoMerge
*.mlproj binary
*.mlx binary
*.p binary
*.plprj binary
*.sbproj binary
*.sfx binary
*.sldd binary
*.slreqx binary merge=mlAutoMerge
*.slmx binary merge=mlAutoMerge
*.sltx binary
*.slxc binary
*.slx binary merge=mlAutoMerge
*.slxp binary

## MATLAB Project metadata files use LF line endings
/resources/project/**/*.xml text eol=lf

## Other common binary file types
*.docx binary
*.exe binary
*.jpg binary
*.pdf binary
*.png binary
*.xlsx binary

# Preserve the exact baseline evidence bytes across platforms.
evidence/p07_gate_b/** -text -whitespace
evidence/p07_candidate_checks/** -text -whitespace
evidence/p07_legacy_schema/** -text -whitespace

# Preserve the exact bytes of the public source identity across Git checkouts.
/* -text
/src/** -text
/studies/** -text
/tests/** -text
/evidence/** -text
/provenance/** -text
/verification/** -text
/private/** -text

# Preserve the exact bytes of retained reference data.
/results/** -text
